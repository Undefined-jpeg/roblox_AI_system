# Copy this file to .env for local testing (Render: set these as dashboard env vars instead).

# Your OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A long random string you generate yourself. Roblox must send this exact value
# in the X-Npc-Secret header on every request, or the proxy rejects it.
SHARED_SECRET=change-me-to-something-long-and-random

# Which OpenRouter model to use. See https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

PORT=3000
